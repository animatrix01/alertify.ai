# Alertify — environment variables
# Copy this file to .env and fill in your values.
# Client-side vars (VITE_*) are inlined at build time and readable in the browser — never put secrets here.

# ── Supabase (required) ─────────────────────────────────────────────
# Browser / Vite build-time
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# Server (SSR / Cloudflare Worker)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# ⚠️ Server ONLY — bypasses RLS. Never expose to the browser. Optional; used by the admin client.
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Groq AI (optional) ──────────────────────────────────────────────
# Used by the server function that generates alert safety summaries.
# Without it, alerts fall back to their original description.
# GROQ_API_KEY=<your-groq-api-key>

# ── Local dev only (optional) ───────────────────────────────────────
# The service worker is disabled in dev by default so it doesn't fight Vite HMR.
# Set to 1 to test PWA notifications locally.
# VITE_ENABLE_SW=1
